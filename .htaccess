# 3D Tech website - server security configuration (Apache)

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# --- Force HTTPS ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Disable directory listing ---
Options -Indexes

# --- Block access to sensitive/non-public file types if ever added ---
<FilesMatch "\.(env|log|md|json|ya?ml|bak|config)$">
  Require all denied
</FilesMatch>

# --- Prevent access to dotfiles (.git, .htaccess itself, etc.) ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Serve the bilingual custom missing-page document while retaining HTTP 404.
ErrorDocument 404 /404.html
